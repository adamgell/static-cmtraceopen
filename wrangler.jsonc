{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "static-cmtraceopen",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-13",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "cmtraceopen.com/*", "zone_name": "cmtraceopen.com" },
    { "pattern": "www.cmtraceopen.com/*", "zone_name": "cmtraceopen.com" },
    { "pattern": "download.cmtraceopen.com", "custom_domain": true },
    // cmtrace.net shortlinks. custom_domain rather than a zone_name route:
    // a route only fires for a hostname that already has a proxied DNS record,
    // and this zone has none, so a route would be inert. custom_domain creates
    // the record and attaches the hostname in one step.
    { "pattern": "cmtrace.net", "custom_domain": true },
    { "pattern": "www.cmtrace.net", "custom_domain": true },
    { "pattern": "win.cmtrace.net", "custom_domain": true },
    { "pattern": "winarm.cmtrace.net", "custom_domain": true },
    { "pattern": "lite.cmtrace.net", "custom_domain": true },
    { "pattern": "mac.cmtrace.net", "custom_domain": true },
    { "pattern": "msi.cmtrace.net", "custom_domain": true },
    { "pattern": "linux.cmtrace.net", "custom_domain": true },
    { "pattern": "nightly.cmtrace.net", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "analytics_engine_datasets": [
    { "binding": "DOWNLOAD_EVENTS", "dataset": "cmtraceopen_download_events" }
  ],
  "observability": { "enabled": false }
}
