{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "static-cmtraceopen",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-13",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "cmtraceopen.com/*", "zone_name": "cmtraceopen.com" },
    { "pattern": "www.cmtraceopen.com/*", "zone_name": "cmtraceopen.com" },
    { "pattern": "download.cmtraceopen.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "analytics_engine_datasets": [
    { "binding": "DOWNLOAD_EVENTS", "dataset": "cmtraceopen_download_events" }
  ],
  "observability": { "enabled": false }
}
