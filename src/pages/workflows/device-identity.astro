---
import { SITE, WORKFLOWS } from "../../data/site";
import ProductLayout from "../../layouts/ProductLayout.astro";

const workflow = WORKFLOWS.find(({ slug }) => slug === "device-identity");
if (!workflow) throw new Error("Missing workflow data: device-identity");
const productDownload = `${SITE.download}?source=cmtraceopen-product`;
const evidenceRoles = [
  "Provides the current AzureAdJoined, DomainJoined, tenant, device, and diagnostic state reported by Windows.",
  "Records registration attempts, scheduled-task activity, discovery, authentication, and the reason codes behind a join transition.",
  "Shows whether device registration and Primary Refresh Token readiness agree for the active user session.",
] as const;
---

<ProductLayout title="Device identity and join — CMTrace Open" description="Investigate Windows device join, registration events, and Primary Refresh Token state as one identity timeline." canonicalPath="/workflows/device-identity/">
  <section class="workflow-hero evidence-grid" aria-labelledby="workflow-heading"><div><span class="technical-label">WORKFLOW 02 · FIELD INVESTIGATION</span><h1 id="workflow-heading">{workflow.label}.</h1><p>{workflow.summary}</p></div></section>
  <section class="investigation section-rule" aria-labelledby="investigation-heading">
    <div class="investigation-start"><span class="technical-label">INVESTIGATION START</span><h2 id="investigation-heading">Start with the affected user and device state.</h2><p>Begin at the moment access, enrollment, or single sign-on stopped behaving as expected. Capture the current join snapshot, then compare it with registration events and token state for the same user session instead of treating every identity symptom as a failed join.</p></div>
    <ol class="evidence-list" aria-label={`${workflow.label} evidence sources`}>{workflow.evidence.map((source, index) => (<li><span class="technical-label">EVIDENCE {String(index + 1).padStart(2, "0")}</span><div><h3><code>{source}</code></h3><p>{evidenceRoles[index]}</p></div></li>))}</ol>
  </section>
  <section class="correlation evidence-grid section-rule" aria-labelledby="correlation-heading"><div><span class="technical-label">WHAT CMTRACE OPEN CONNECTS</span><h2 id="correlation-heading">Separate device join from sign-in readiness.</h2></div><div><p>CMTrace Open lines up the DSRegCmd snapshot with User Device Registration events and PRT evidence, making it clear when the device object is joined but the user token is missing, stale, or blocked by a later authentication step.</p><a class="button button-primary" href={productDownload}>Open stable downloads</a></div></section>
</ProductLayout>

<style>
  .workflow-hero { display: grid; min-height: 34rem; align-items: end; }
  .workflow-hero > div { max-width: 66rem; }
  h1 { max-width: 12ch; margin: var(--space-3) 0 var(--space-4); }
  .workflow-hero p, .investigation-start p, .correlation p { max-width: 50rem; font-size: clamp(1.0625rem, 2vw, 1.35rem); }
  .investigation, .correlation { display: grid; grid-template-columns: minmax(18rem, .75fr) minmax(0, 1.25fr); gap: var(--space-7); }
  .investigation-start h2, .correlation h2 { max-width: 12ch; margin: var(--space-3) 0 var(--space-4); }
  .evidence-list { margin: 0; padding: 0; border-top: 1px solid var(--line-strong); list-style: none; }
  .evidence-list li { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-5); border-bottom: 1px solid var(--line); }
  .evidence-list h3 { margin: 0 0 var(--space-2); font-size: clamp(1.25rem, 2.3vw, 2rem); }
  .evidence-list p { margin: 0; }
  .correlation p { margin-bottom: var(--space-5); }
  @media (max-width: 900px) { .investigation, .correlation { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); } }
  @media (max-width: 560px) { .evidence-list li { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); } }
</style>
