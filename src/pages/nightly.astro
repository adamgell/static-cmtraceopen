---
import ProductLayout from "../layouts/ProductLayout.astro";
import "../styles/nightly.css";
---

<ProductLayout
  title="Nightly builds — CMTrace Open"
  description="Test signed CMTrace Open development packages published from the latest successful nightly workflow."
  canonicalPath="/nightly/"
>
  <section class="nightly-hero evidence-grid" aria-labelledby="nightly-heading">
    <div class="nightly-copy">
      <span class="technical-label">NIGHTLY CHANNEL · DEVELOPMENT BUILDS</span>
      <h1 id="nightly-heading">Builds from main, ready for testing.</h1>
      <p>Signed development packages from the latest successful nightly workflow. Expect change; use the stable channel for production endpoints.</p>
    </div>
    <aside class="channel-note" aria-label="Nightly channel guidance">
      <span class="technical-label">CHANNEL CONTRACT</span>
      <strong>Fresh code. Short shelf life.</strong>
      <p>The mutable nightly release is replaced as main advances. These files are for validation, not managed production rollout.</p>
      <button class="refresh-control" type="button" data-nightly-refresh>Refresh build data</button>
    </aside>
  </section>

  <section class="nightly-builds section-rule" aria-label="Nightly packages">
    <div class="nightly-groups" data-nightly-groups></div>

    <noscript>
      <p class="nightly-error">Nightly discovery requires JavaScript. <a href="https://github.com/adamgell/cmtraceopen/releases/tag/nightly">Open the nightly release on GitHub</a>.</p>
    </noscript>
  </section>

  <section class="stable-handoff" aria-labelledby="stable-heading">
    <span class="technical-label">NEED THE SUPPORTED CHANNEL?</span>
    <div>
      <h2 id="stable-heading">Use stable for production endpoints.</h2>
      <p>Choose the current supported package for normal use and managed deployment.</p>
    </div>
    <a class="button button-primary" href="https://download.cmtraceopen.com/?source=nightly-builds-page">Open stable downloads</a>
  </section>

  <script>
    import "../scripts/nightly";
  </script>
</ProductLayout>
