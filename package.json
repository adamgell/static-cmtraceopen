{
  "name": "static-cmtraceopen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "check": "astro check",
    "test:content": "npm run build && node --test tests/content.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:worker": "playwright test --config playwright.worker.config.ts",
    "test": "npm run test:content && npm run test:e2e",
    "types:worker": "wrangler types src/worker-configuration.d.ts",
    "test:worker": "npm run types:worker && vitest run --config vitest.config.ts",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "preview:worker": "npm run build && wrangler dev --local --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "astro": "7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@playwright/test": "1.61.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
